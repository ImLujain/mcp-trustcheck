{
  "mcpServers": {
    "fs-everything": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2026.1.0", "/"]
    },
    "fs-home": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2026.1.0", "/Users/alice", "/Users/alice/Projects/app"]
    },
    "fs-ssh": {
      "command": "uvx",
      "args": ["mcp-server-fs==0.9.0", "--root", "/Users/alice/.ssh"]
    },
    "fs-docker": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-v", "/:/host", "example.invalid/fs-mcp:1.0"]
    }
  }
}
