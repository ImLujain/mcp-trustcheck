{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2026.1.0", "/Users/alice/Projects/app", "/Users/alice/Projects/docs"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@2026.1.0"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}" }
    },
    "remote-crm": {
      "url": "https://crm.example.com/mcp",
      "headers": { "Authorization": "Bearer ${env:CRM_TOKEN}" }
    },
    "local-dev": {
      "url": "http://localhost:3000/mcp"
    }
  }
}
